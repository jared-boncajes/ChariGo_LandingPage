# Copy this file to .env and fill it in. Never commit .env.

# Mail account that sends the subscription emails.
# Gmail: turn on 2-Step Verification, then create an "App password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Name and address subscribers see in the "From" line (defaults to ChariGo <SMTP_USER>).
MAIL_FROM=ChariGo <your-address@gmail.com>

# Optional: get an email here every time someone subscribes.
NOTIFY_EMAIL=
